# One Argo CD Application per tenant order (duplicate or use ApplicationSet).
# Apply after pushing bootstrap-tenant to your fork.
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: lightwell-tenant-REPLACE_GUID
  namespace: openshift-gitops
  finalizers:
    - resources-finalizer.argocd.argoproj.io
spec:
  project: default
  source:
    repoURL: https://github.com/sshaaf/lightwell-workshop.git
    targetRevision: demo-update
    path: automation/gitops/bootstrap-tenant
    helm:
      values: |
        guid: REPLACE_GUID
        username: user-REPLACE_GUID
        password: REPLACE_ME
        deployer:
          domain: apps.cluster-dvb52.dyn.redhatworkshops.io
          storageClass: ocs-external-storagecluster-ceph-rbd-immediate
        nexus:
          lightwellNetwork:
            username: REPLACE_ME
            password: REPLACE_ME
  destination:
    server: https://kubernetes.default.svc
    namespace: openshift-gitops
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
