# Optional second layer per tenant: lw-demo-test-agents (OpenCode, secrets, nexus-webhooks app).
# Apply after bootstrap-tenant is healthy and cluster-config values are set for this guid.
#
# 1. Fork/patch gitops/base/cluster-config for:
#    GUID, NEXUS_NAMESPACE=lightwell-nexus-<guid>, NEXUS_URL, EDA_WEBHOOK_URL,
#    REMEDIATION_APP_GITLAB_PATH, TPA_SBOM_LABEL, EDA_ORGANIZATION_NAME=user-<guid>
# 2. Create secrets in sdlc-control-plane (or sdlc-control-plane-<guid>) per gitops/secrets/README.md
# 3. Either rely on bootstrap-tenant in-chart Jobs (eda-bootstrap, nexus-reconcile) OR sync nexus-webhooks from lw-demo-test-agents
---
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: sdlc-tenant-REPLACE_GUID
  namespace: openshift-gitops
  labels:
    lightwell.guid: REPLACE_GUID
spec:
  project: default
  source:
    repoURL: https://github.com/sshaaf/lw-demo-test-agents.git
    targetRevision: main
    path: gitops/argocd/applications
    directory:
      recurse: true
  destination:
    server: https://kubernetes.default.svc
    namespace: openshift-gitops
  syncPolicy:
    automated:
      prune: false
      selfHeal: true
    syncOptions:
      - CreateNamespace=false
