        "\\[.*,role=.*\\]",
        "\\+\\+\\+.*\\+\\+\\+",
        "^\\[.*\\]$",
        "`[^`]*`",
        "^\\|.*\\|$",
        "^====+$",
        "^----+$",
        "^\\.\\.\\.\\.+$",
        "^\\*\\*\\*\\*+$",
        "^<.*>$",
        "xref:.*\\[.*\\]",
        "image::.*\\[.*\\]",
        "image:.*\\[.*\\]",
        "include::.*\\[.*\\]",
        "link:.*\\[.*\\]",
        "ifdef::.*\\[\\]",
        "ifndef::.*\\[\\]",
        "endif::.*\\[\\]",
        "^:.*:.*$"
      ]
    }
  ],
