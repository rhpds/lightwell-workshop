  "overrides": [
    {
      "filename": "**/*.adoc",
      "ignoreRegExpList": [
        "/^\\s*----[\\s\\S]*?^\\s*----\\s*$/gm",
        "/^\\s*\\+\\+\\+\\+[\\s\\S]*?^\\s*\\+\\+\\+\\+\\s*$/gm",
